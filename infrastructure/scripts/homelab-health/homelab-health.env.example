# Copiar a ~/.config/homelab-health.env y ajustar. Los hosts son alias de ~/.ssh/config.
PVE_NODES="pve-1 pve-2 pve-3"      # el primero se usa para leer PBS y el job de backup
PBS_STORAGE=pbs                     # nombre del storage PBS en Proxmox
NAS=nas                             # TrueNAS: ZFS, SMART y alertas
DOCKER_HOSTS="docker-main nas"         # hosts con Docker
DOCKER_ON_DEMAND="jdownloader"      # contenedores que se arrancan solo cuando hacen falta
OPNSENSE=firewall
GATUS_URL=http://192.0.2.32:8080    # opcional
NTFY_URL=http://192.0.2.31          # opcional: con --ntfy envía el resumen
NTFY_TOPIC=homelab-alertas
PING_HOSTS="bmc:192.0.2.50 router:192.0.2.1"    # opcional: nombre:ip de equipos sin SSH
VPN_CONTAINERS="torrent"            # opcional: contenedores del NAS que deben salir por la VPN
FORGEJO_HOST=docker-main               # opcional: volcados de la BD de Forgejo
FORGEJO_DUMP_DIR=/srv/forgejo/backups
OFFSITE_ENV=/srv/secrets/backup-offsite.env      # opcional: configuración de la copia externa, en el NAS

# Umbrales (valores por defecto)
#BACKUP_MAX_AGE_H=26
#DISK_WARN_PCT=85
#SSD_LIFE_WARN=30
#HDD_TEMP_WARN=45
#SSD_TEMP_WARN=55
#SCRUB_MAX_AGE_D=35
#MEM_WARN_PCT=90
#STATE_DIR=~/.local/state/homelab-health   # histórico SMART para la tendencia de escrituras
