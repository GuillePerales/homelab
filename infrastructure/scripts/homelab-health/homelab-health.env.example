# Copiar a ~/.config/homelab-health.env y ajustar. Los hosts son alias de ~/.ssh/config.
PVE_NODES="pve-1 pve-2 pve-3"      # el primero se usa para leer PBS y el job de backup
PBS_STORAGE=pbs                     # nombre del storage PBS en Proxmox
NAS=nas                             # TrueNAS: ZFS, SMART y alertas
DOCKER_HOSTS="docker-1 nas"         # hosts con Docker
OPNSENSE=firewall
GATUS_URL=http://192.0.2.32:8080    # opcional
NTFY_URL=http://192.0.2.31          # opcional: con --ntfy envía el resumen
NTFY_TOPIC=homelab-alertas

# Umbrales (valores por defecto)
#BACKUP_MAX_AGE_H=26
#DISK_WARN_PCT=85
#SSD_LIFE_WARN=30
#HDD_TEMP_WARN=45
#SSD_TEMP_WARN=55
