# Copiar a /mnt/vault/secrets/fan-control.env y ajustar
# SSD que sigue Fan1 (el de la bahía 0, delante de Fan1), por /dev/disk/by-id
SSD_BAHIA0=/dev/disk/by-id/ata-MODELO_SERIE
# HDD que también tiran de Fan2-4, separados por comas (no se despiertan si están en reposo)
HDDS=/dev/disk/by-id/ata-MODELO_SERIE1,/dev/disk/by-id/ata-MODELO_SERIE2
# Si existe este fichero, el script devuelve el control al iDRAC y no hace nada más
PAUSA=/mnt/vault/secrets/fan-control.pausa
