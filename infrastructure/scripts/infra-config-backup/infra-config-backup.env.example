# Copiar a /mnt/vault/secrets/infra-config-backup.env y ajustar
DEST=/mnt/vault/secrets/infra
KEEP_DAYS=30
SSH_KEY=/mnt/vault/secrets/ssh/backup-infra_ed25519
OPNSENSE=root@192.0.2.1
# nombre=usuario@host, separados por espacios
PVE_NODES="pve-router=root@192.0.2.11 pve-main=root@192.0.2.12 pve-aux=root@192.0.2.13"
NTFY_URL=http://192.0.2.31
NTFY_TOPIC=homelab-alertas
