# La escribe el rol de Ansible `trivy_scan` en /srv/trivy-scan/trivy-scan.env (sin secretos)
NTFY_URL=http://192.0.2.31/
NTFY_TOPIC=homelab-actualizaciones
# Prometheus con el job de cAdvisor de los hosts Docker (la lista de imágenes sale de ahí)
PROMETHEUS_URL=http://192.0.2.51:9090
CADVISOR_JOB=cadvisor
# Versión fijada: subirla a propósito (no la vigila diun, porque no queda corriendo)
TRIVY_IMAGE=aquasec/trivy:0.76.2
DATA_DIR=/srv/trivy-scan
INFORMES_MAX=8
# Collector textfile del node_exporter del host (vacío = sin métricas)
TEXTFILE_DIR=/var/lib/node_exporter/textfile
SEVERIDAD=HIGH,CRITICAL
# Imágenes que no se escanean (separadas por comas)
IGNORAR=
# Segundos por imagen y para todo el escaneo (las que no quepan salen como no escaneadas)
TIMEOUT_IMAGEN=600
TOPE_TOTAL=10800
