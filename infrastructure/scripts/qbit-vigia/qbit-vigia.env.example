# Copiar a /mnt/vault/secrets/qbit-vigia.env y ajustar
NTFY_URL=http://192.0.2.31/
NTFY_TOPIC_ALERTAS=homelab-alertas
NTFY_TOPIC_MEDIA=homelab-media
QBIT_CONTAINER=qbittorrent
STATE_FILE=/mnt/vault/cache/qbit-vigia/state.json
# Horas de seed mínimo por tracker (dominio=horas); el resto de privados usa el defecto
SEED_MINIMO=torrenteros.org=72,milnueve.cc=96
SEED_MINIMO_DEFECTO=72
# Resumen semanal: día (0 = lunes) y hora
RESUMEN_DIA=0
RESUMEN_HORA=9
# Recreación automática de Gluetun + qBittorrent cuando no es conectable
RECREAR_DIR=/mnt/vault/apps/qbittorrent
RECREAR_PROYECTO=qbittorrent
RECREAR_MAX_DIA=3
# Diagnóstico: logs de Gluetun antes de recrear y conexion.log en cada pasada sin conexión
GLUETUN_CONTAINER=gluetun-qbittorrent
LOG_DIR=/mnt/vault/cache/qbit-vigia/logs
LOG_DIAS=14
# Sin puerto: reinicios de la VPN de Gluetun al día antes de pasar a recrear; aviso si sigue
# «firewalled» con puerto durante este número de pasadas seguidas
VPN_MAX_DIA=8
FIREWALLED_PASADAS=4
# Mularr: IP de origen=contenedor de cada app que lo usa como cliente de descargas; si Mularr
# les rechaza la cookie de sesión (tras reiniciarse), se reinicia la app. Vacío = desactivado
MULARR_CONTAINER=mularr
MULARR_APPS=192.0.2.12=radarr,192.0.2.11=sonarr
MULARR_REINICIOS_MAX_DIA=4
# Métricas para Prometheus: directorio del textfile collector del node_exporter del NAS (el compose de
# node-exporter-nas lo lee como /host/<esta ruta>) y los Gluetun cuyos reinicios de VPN se cuentan
METRICS_DIR=/mnt/vault/cache/qbit-vigia/metrics
METRICS_GLUETUN=gluetun-qbittorrent,gluetun-mularr
