# Copiar a /mnt/vault/secrets/qbit-vigia.env y ajustar
NTFY_URL=http://192.0.2.31/
NTFY_TOPIC_ALERTAS=homelab-alertas
NTFY_TOPIC_MEDIA=homelab-media
QBIT_CONTAINER=qbittorrent
STATE_FILE=/mnt/vault/cache/qbit-vigia/state.json
# Horas de seed mínimo por tracker (dominio=horas); el resto de privados usa el defecto
SEED_MINIMO=torrenteros.org=72,milnueve.cc=96
SEED_MINIMO_DEFECTO=72
# Resumen semanal: día (0 = lunes) y hora
RESUMEN_DIA=0
RESUMEN_HORA=9
# Recreación automática de Gluetun + qBittorrent cuando no es conectable
RECREAR_DIR=/mnt/vault/apps/qbittorrent
RECREAR_PROYECTO=qbittorrent
RECREAR_MAX_DIA=3
