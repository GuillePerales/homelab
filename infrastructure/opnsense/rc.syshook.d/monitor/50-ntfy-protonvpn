#!/usr/local/bin/php
<?php

/*
 * Aviso a ntfy cuando el gateway de ProtonVPN cae o se recupera.
 * Lo ejecuta OPNsense (rc.syshook monitor) en cada alarma de dpinger, con los
 * gateways afectados en argv[1]. Solo avisa en las transiciones caída/recuperación,
 * no en las pérdidas parciales de paquetes.
 *
 * Proton descarta a ratos el ping a su gateway (10-20 % de pérdida), y dpinger
 * alterna entonces entre «down» y «none» cada pocos minutos. Para no avisar de
 * eso, una caída se confirma pasados $hold segundos: el hook lanza en segundo
 * plano una segunda pasada (--confirmar) que solo avisa si sigue caído. La
 * recuperación solo se avisa si antes se avisó la caída.
 */

require_once 'config.inc';
require_once 'util.inc';
require_once 'interfaces.inc';

$watch = 'PROTONVPN_GW';
$ntfy = 'http://192.0.2.31/';   /* IP real de ntfy: ajustar al instalar */
$topic = 'homelab-alertas';
$statefile = '/var/run/ntfy-protonvpn.state';   /* up, pendiente o down */
$hold = 300;

function gateway_state($name)
{
    foreach (return_gateways_status() as $status) {
        if ($status['name'] == $name) {
            if (strpos($status['status'], 'down') !== false) {
                return 'down';
            }
            return $status['status'] == 'none' ? 'up' : 'loss';
        }
    }
    return null;
}

function notify($down)
{
    global $ntfy, $topic, $hold;

    $msg = $down
        ? ['title' => 'ProtonVPN caída', 'priority' => 4, 'tags' => ['rotating_light'],
           'message' => sprintf('El túnel lleva más de %d min sin responder: JDownloader se queda sin conexión (kill switch). Se recupera solo cuando vuelva.', $hold / 60)]
        : ['title' => 'ProtonVPN recuperada', 'priority' => 2, 'tags' => ['white_check_mark'],
           'message' => 'El túnel vuelve a responder: las descargas salen otra vez por la VPN.'];
    $msg['topic'] = $topic;

    /* el PHP de OPNsense tiene allow_url_fopen desactivado: se envía con curl */
    exec(sprintf('/usr/local/bin/curl -sf -m 10 -H %s -d %s %s',
        escapeshellarg('Content-Type: application/json'),
        escapeshellarg(json_encode($msg)), escapeshellarg($ntfy)), $out, $rc);
    if ($rc !== 0) {
        log_msg('ntfy-protonvpn: no se pudo avisar (' . ($down ? 'down' : 'up') . ')', LOG_WARNING);
    }
}

$prev = @file_get_contents($statefile) ?: 'up';

/* segunda pasada: ¿sigue caído tras la espera? */
if (($argv[1] ?? '') == '--confirmar') {
    sleep($hold);
    $prev = @file_get_contents($statefile) ?: 'up';
    if ($prev != 'pendiente') {
        exit(0);
    }
    if (gateway_state($watch) == 'down') {
        file_put_contents($statefile, 'down');
        notify(true);
    } else {
        file_put_contents($statefile, 'up');
    }
    exit(0);
}

$affected = !empty($argv[1]) ? explode(',', $argv[1]) : [];
if (!in_array($watch, $affected)) {
    exit(0);
}

$now = gateway_state($watch);
if ($now == 'down' && $prev == 'up') {
    file_put_contents($statefile, 'pendiente');
    exec(sprintf('/usr/sbin/daemon -f /usr/local/bin/php %s --confirmar', escapeshellarg(__FILE__)));
} elseif ($now == 'up' && $prev != 'up') {
    file_put_contents($statefile, 'up');
    if ($prev == 'down') {
        notify(false);
    }
}
/* «loss»: esperar a que dpinger se decida */
