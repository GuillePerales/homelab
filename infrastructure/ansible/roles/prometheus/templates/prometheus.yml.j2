# Generado por Ansible (rol prometheus): no editar a mano.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml
{% if prometheus_alertmanagers %}

alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for am in prometheus_alertmanagers %}
            - {{ am }}
{% endfor %}
{% endif %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

{% if prometheus_alertmanagers %}
  - job_name: alertmanager
    static_configs:
      - targets:
{% for am in prometheus_alertmanagers %}
          - {{ am }}
{% endfor %}

{% endif %}
{% if prometheus_grafana_targets %}
  - job_name: grafana
    static_configs:
      - targets:
{% for g in prometheus_grafana_targets %}
          - {{ g }}
{% endfor %}

{% endif %}
  - job_name: node
    static_configs:
{% for h in prometheus_node_hosts %}
      - targets: ["{{ hostvars[h].monitoring_address }}:{{ prometheus_node_port }}"]
        labels:
          host: {{ h }}
{% endfor %}

{% if prometheus_cadvisor_hosts %}
  - job_name: cadvisor
    static_configs:
{% for h in prometheus_cadvisor_hosts %}
      - targets: ["{{ hostvars[h].cadvisor_container_ip }}:{{ prometheus_cadvisor_port }}"]
        labels:
          host: {{ h }}
{% endfor %}
{% endif %}

{% if prometheus_smartctl_hosts %}
  - job_name: smartctl
    scrape_interval: 1m
    scrape_timeout: 30s
    static_configs:
{% for h in prometheus_smartctl_hosts %}
      - targets: ["{{ hostvars[h].smartctl_address | default(hostvars[h].monitoring_address) }}:{{ prometheus_smartctl_port }}"]
        labels:
          host: {{ h }}
{% endfor %}
{% endif %}

{% if prometheus_blackbox_address %}
  - job_name: blackbox
    metrics_path: /probe
    scrape_interval: 1m
    scrape_timeout: 15s
    file_sd_configs:
      - files: [/etc/prometheus/targets/blackbox.yml]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [module]
        target_label: __param_module
      - target_label: __address__
        replacement: {{ prometheus_blackbox_address }}
{% endif %}

{% if prometheus_qbittorrent_address %}
  - job_name: qbittorrent
    scrape_interval: 1m
    scrape_timeout: 30s
    static_configs:
      - targets: ["{{ prometheus_qbittorrent_address }}"]
    metric_relabel_configs:
      # https://tracker.ejemplo:443/<passkey>/announce o udp://tracker.ejemplo:6969/announce -> tracker.ejemplo
      - source_labels: [tracker]
        regex: '[a-z]+://([^/:]+).*'
        target_label: tracker
        replacement: '$1'
{% endif %}

{% if prometheus_pve_exporter_address and prometheus_pve_target %}
  - job_name: pve
    scrape_interval: 1m
    scrape_timeout: 30s
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["0"]
    static_configs:
      - targets: ["{{ prometheus_pve_target }}"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ prometheus_pve_exporter_address }}
    metric_relabel_configs:
      # Una serie por estado y por VM o CT; no se usa HA ni bloqueos
      - source_labels: [__name__]
        regex: pve_ha_state|pve_lock_state
        action: drop
{% endif %}

{% if prometheus_opnsense_exporter_address %}
  - job_name: opnsense
    scrape_interval: 1m
    scrape_timeout: 30s
    static_configs:
      - targets: ["{{ prometheus_opnsense_exporter_address }}"]
{% endif %}

{% if prometheus_pbs_exporter_address %}
  - job_name: pbs
    scrape_interval: 1m
    scrape_timeout: 30s
    static_configs:
      - targets: ["{{ prometheus_pbs_exporter_address }}"]
{% endif %}


{% if prometheus_k3s_address %}
  # K3s: el API server y el kubelet comparten registro de métricas, así que /metrics devuelve lo mismo
  # en 6443 y en 10250 (~56 000 series). Se recoge una vez y solo lo que usan el dashboard y las alertas.
  - job_name: k3s
    scheme: https
    scrape_interval: 1m
    scrape_timeout: 30s
    authorization:
      credentials_file: /etc/prometheus/secrets/k3s-token
    tls_config:
      ca_file: /etc/prometheus/secrets/k3s-ca.crt
    static_configs:
      - targets: ["{{ prometheus_k3s_address }}:{{ prometheus_k3s_apiserver_port }}"]
        labels:
          host: {{ groups['k3s_nodes'] | first }}
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'apiserver_request_total|apiserver_request_duration_seconds_(sum|count)|apiserver_current_inflight_requests|apiserver_storage_size_bytes|apiserver_resource_objects|kubelet_running_(pods|containers)|kubelet_volume_stats_(used|capacity)_bytes|process_(cpu_seconds_total|resident_memory_bytes|start_time_seconds)|go_goroutines'
        action: keep

  - job_name: k3s-cadvisor
    scheme: https
    scrape_interval: 30s
    scrape_timeout: 20s
    metrics_path: /metrics/cadvisor
    authorization:
      credentials_file: /etc/prometheus/secrets/k3s-token
    tls_config:
      ca_file: /etc/prometheus/secrets/k3s-ca.crt
    static_configs:
      - targets: ["{{ prometheus_k3s_address }}:{{ prometheus_k3s_kubelet_port }}"]
        labels:
          host: {{ groups['k3s_nodes'] | first }}
    metric_relabel_configs:
      # Series que ningún panel usa y que multiplican la cardinalidad
      - source_labels: [__name__]
        regex: 'container_tasks_state|container_memory_failures_total|container_blkio_.*|container_fs_.*|container_spec_.*'
        action: drop

  - job_name: kube-state-metrics
    scrape_interval: 30s
    scrape_timeout: 20s
    static_configs:
      - targets: ["{{ prometheus_k3s_address }}:{{ prometheus_k3s_ksm_port }}"]
        labels:
          host: {{ groups['k3s_nodes'] | first }}
{% endif %}
