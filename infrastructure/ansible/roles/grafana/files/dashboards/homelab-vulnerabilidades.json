    {
      "type": "timeseries",
      "title": "Evolución de CRITICAL",
      "description": "Total de CRITICAL con arreglo por escaneo (escalón semanal). Sube con imágenes nuevas o CVE nuevos; baja al actualizar.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(trivy_scan_vulnerabilities{severity=\"CRITICAL\",hosts=~\".*$host.*\"})",
          "refId": "A",
          "legendFormat": "CRITICAL",
          "datasource": {
