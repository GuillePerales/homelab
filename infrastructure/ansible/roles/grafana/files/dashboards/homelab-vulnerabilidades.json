            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Hosts sin datos",
      "description": "Hosts Docker cuyo cAdvisor estaba caído durante el escaneo: sus imágenes no entraron.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(trivy_scan_hosts_missing) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
