    {
      "type": "table",
      "title": "Todas las imágenes",
      "description": "Una fila por imagen en marcha, con los hosts donde corre. Ordenable por columna.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "expr": "max by (image, hosts) (trivy_scan_vulnerabilities{severity=\"CRITICAL\",hosts=~\".*$host.*\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (image, hosts) (trivy_scan_vulnerabilities{severity=\"HIGH\",hosts=~\".*$host.*\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "image": 0,
              "hosts": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "image": "Imagen",
              "hosts": "Hosts",
              "Value #A": "CRITICAL",
              "Value #B": "HIGH"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "CRITICAL",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 110
