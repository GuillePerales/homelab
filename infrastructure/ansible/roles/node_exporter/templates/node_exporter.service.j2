[Unit]
Description=Prometheus node_exporter
Wants=network-online.target
After=network-online.target

[Service]
User={{ node_exporter_user }}
Group={{ node_exporter_user }}
{% if node_exporter_rapl_enabled | default(false) %}
# El prefijo + lo ejecuta como root fuera de la sandbox; el - tolera que falle
ExecStartPre=+-{{ node_exporter_tmpfiles_bin }} --create {{ node_exporter_rapl_tmpfiles }}
{% endif %}
ExecStart={{ node_exporter_bin }} \
  --web.listen-address={{ node_exporter_listen }} \
{% for c in node_exporter_extra_collectors %}
  --collector.{{ c }} \
{% endfor %}
  --collector.textfile.directory={{ node_exporter_textfile_dir }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
