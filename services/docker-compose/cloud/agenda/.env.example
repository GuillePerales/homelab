# docker-main macvlan srv-net — rango 192.0.2.26-41
CONTAINER_IP=192.0.2.35
TZ=Europe/Madrid
APPDATA=/opt/appdata/agenda
# Apple ID y contraseña de app (account.apple.com → Inicio de sesión y seguridad → Contraseñas de apps)
ICLOUD_USER=apple-id@example.com
ICLOUD_PASS=contrasena-de-app
# Calendarios de iCloud en los que se pueden crear citas (nombre exacto), separados por comas
CALENDARIOS=Eventos
CALENDARIO_DEFECTO=Eventos
