# Imagen de salud: Python + SDK oficial de Garmin para leer FIT + matplotlib para el informe mensual en PDF.
# Los scripts se montan aparte (como agenda), así que la imagen solo cambia al subir de versión una dependencia.
FROM python:3.13.3-slim
RUN pip install --no-cache-dir garmin-fit-sdk==21.221.0 matplotlib==3.10.1
