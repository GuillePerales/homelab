# docker-main macvlan srv-net — rango 192.0.2.26-41
CONTAINER_IP=192.0.2.38
TZ=Europe/Madrid
APPDATA=/opt/appdata/salud
# Clave personal de Garmin Connect (connect.garmin.com → ajustes → Personal API), caduca en 1 año como máximo
GARMIN_API_KEY=clave
# Horas del día (locales) a las que sincroniza los últimos días
SYNC_HORAS=7,13,22
# Topic de ntfy donde avisar si falla la sincronización (URL completa)
NTFY_URL=
