# docker-nas macvlan srv-net — fuera del rango .10-.25, que está lleno
CONTAINER_IP=192.0.2.42
PUID=3000
PGID=3000
TZ=Europe/Madrid
APPDATA=/mnt/vault/apps/mularr/data
DATA=/mnt/tank/data
AUTH_USERNAME=admin
AUTH_PASSWORD=cambiar
API_KEY=cambiar
# ProtonVPN: clave privada de una configuración WireGuard con NAT-PMP (reenvío de puerto) activado
WIREGUARD_PRIVATE_KEY=cambiar
VPN_COUNTRIES=Switzerland
# Redes internas a las que puede salir fuera del túnel
LAN_SUBNETS=192.0.2.0/24
